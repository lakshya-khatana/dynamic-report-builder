# Copy this file to .env (same folder as main.py) and fill in FERNET_KEY.
# Do NOT commit or share your real .env.

ENV=development

# Key used to encrypt saved data-source credentials.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Optional overrides (defaults are in config.py):
# APP_DB_URL=sqlite:///./storage/app.db
# QUERY_TIMEOUT_SECONDS=30
# PREVIEW_ROW_LIMIT=100
